{
  "name": "bbrab-unified-icons",
  "version": "0.1.0",
  "description": "A policy-aware SVG icon system, UI audit CLI, safe codemod, and agent toolkit.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bbrab-unified-icons": "./bin/bbrab-icons.js",
    "bbrab-icons": "./bin/bbrab-icons.js",
    "bbrab-icons-mcp": "./agent/mcp-server.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./icons": "./src/icons.js",
    "./policy": "./src/policy.js"
  },
  "files": [
    "agent",
    "bin",
    "docs",
    "prompts",
    "skill",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "audit:example": "node ./bin/bbrab-icons.js audit ./examples --format markdown",
    "check": "node ./bin/bbrab-icons.js check",
    "test": "node --test",
    "verify": "npm run check && npm test && npm run audit:example"
  },
  "keywords": [
    "svg",
    "icons",
    "design-system",
    "accessibility",
    "codemod",
    "mcp",
    "agent"
  ]
}
